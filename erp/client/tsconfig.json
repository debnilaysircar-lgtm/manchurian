{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@backend": [
        "./src/backend/http.ts"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/demo"
  ]
}